# 复制为 .env 后按需修改。本文件只放占位符，禁止提交任何真实密钥。
# 一键安装会自动生成 .env（随机密钥与口令）：powershell -ExecutionPolicy Bypass -File scripts\install.ps1

HOST=127.0.0.1
PORT=8000

# ---------- 离线硬约束 ----------
# 1 = 只允许访问本机/园内局域网（10/8、172.16/12、192.168/16、*.local），外网请求直接拦截
OFFLINE_ONLY=1
# 如确有园内域名（非字面私有 IP），在此显式登记，逗号分隔
# ALLOWED_HOSTS=ocr.lan,vlm.lan

# ---------- 身份与口令 ----------
# 教师端数字口令（首次部署后请修改；仅对教师开放会话/绘本/建议）
TEACHER_PIN=2026
# 管理员口令（自检、运维、删除、授权管理）
ADMIN_PIN=8642
# 会话 Cookie 签名密钥；留空则每次启动随机生成（重启后需重新登录）
SECRET_KEY=

# ---------- 存储 ----------
DATA_DIR=data
# 原图是否落盘（规范 §5.7：调用返回后立即释放，默认 0 不存）
KEEP_PAGE_IMAGE=0
# 连续用眼多少分钟提醒休息（0 = 关闭）
EYE_REST_MINUTES=20
# 是否铺示例数据（4 个孩子 / 2 本绘本 / 1 次已结束共读）。真实部署保持 0，空库起步
SEED_DEMO=0

# ---------- 五个引擎 ----------
# local = 引擎在本进程/本机跑（OCR / ASR / TTS）
# http  = 园内 OpenAI 兼容服务（LLM / VLM，本机 Ollama 也算 http）
# stub  = 确定性规则（仅测试与降级；只要有一个 stub，界面就标"演示模式"）
OCR_MODE=local
ASR_MODE=local
TTS_MODE=local
LLM_MODE=http
VLM_MODE=http

# 本机 Ollama（默认端口 11434）：语言与看图
LLM_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:3b
# 单次生成上限：别让"会思考"的模型把孩子晾在那（不要用 deepseek-r1 做提问模型）
LLM_MAX_TOKENS=768
VLM_URL=http://127.0.0.1:11434/v1
VLM_MODEL=qwen2.5vl:3b

# 语音识别（faster-whisper）：模型目录由 scripts/fetch_models.py 下载
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_MODEL_DIR=models/whisper
# 本机 TTS 语音名（留空自动挑中文女声，一般是 Microsoft Huihui Desktop）
TTS_LOCAL_VOICE=
FFMPEG_BIN=ffmpeg

# 若改用园内 GPU 集群，把 *_MODE 改 http 并填地址：
# OCR_URL=http://192.168.1.21:9101
# ASR_URL=http://192.168.1.21:9104
# TTS_URL=http://192.168.1.21:9105
# TTS_VOICE=zh-CN-kids

# ---------- 交互节奏（规范 §4.3）----------
# 翻页后留给孩子看画面的时间，到点才提问
QUESTION_DELAY_SECONDS=8
# 等孩子回答的最长时间，超时转图标二选一
LISTEN_TIMEOUT_SECONDS=20
# 老师长时间不操作，自动进入下一步
TEACHER_TIMEOUT_SECONDS=15
# 单会话最多页数 / 单日模型调用上限（超限降级为轻量模板）
PAGE_LIMIT_PER_SESSION=60
DAILY_CALL_LIMIT=3000

# 童声 ASR 置信度低于该值时走"你是不是说 XX？"确认式追问，不猜
ASR_CONFIRM_THRESHOLD=0.75
