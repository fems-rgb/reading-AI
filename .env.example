# 复制为 .env 后按需修改。本文件只放占位符，禁止提交任何真实密钥。
# （旧 y.zip 中的百炼 API Key 已泄露，必须到控制台吊销并轮换；本系统完全离线，不再使用任何云密钥。）

HOST=127.0.0.1
PORT=8000

# ---------- 离线硬约束 ----------
# 1 = 只允许访问本机/园内局域网（10/8、172.16/12、192.168/16、*.local），外网请求直接拦截
OFFLINE_ONLY=1
# 如确有园内域名（非字面私有 IP），在此显式登记，逗号分隔
# ALLOWED_HOSTS=ocr.lan,vlm.lan

# ---------- 身份与口令 ----------
# 教师端 4-6 位数字口令（首次部署后请修改；仅对教师开放会话/绘本/建议）
TEACHER_PIN=2026
# 管理员口令（自检、运维、删除、授权管理）
ADMIN_PIN=8642
# 会话 Cookie 签名密钥；留空则每次启动随机生成（重启后需重新登录）
SECRET_KEY=

# ---------- 存储 ----------
DATA_DIR=data
# 原图是否落盘（规范 §5.7：调用返回后立即释放，默认 0 不存）
KEEP_PAGE_IMAGE=0

# ---------- 模型接入方式（stub=确定性本地规则，http=园内 GPU 服务）----------
OCR_MODE=stub
VLM_MODE=stub
LLM_MODE=stub
ASR_MODE=stub
TTS_MODE=stub

# 园内模型服务地址（OCR_MODE 等为 http 时必填；只允许内网地址）
OCR_URL=http://127.0.0.1:9101
VLM_URL=http://127.0.0.1:9102/v1
VLM_MODEL=qwen3-vl-8b-instruct
LLM_URL=http://127.0.0.1:9103/v1
LLM_MODEL=qwen3-8b-instruct
ASR_URL=http://127.0.0.1:9104
TTS_URL=http://127.0.0.1:9105
TTS_VOICE=zh-CN-kids

# ---------- 交互节奏（规范 §4.3）----------
# 翻页后留给孩子看画面的时间，到点才提问
QUESTION_DELAY_SECONDS=8
# 等孩子回答的最长时间，超时转图标二选一
LISTEN_TIMEOUT_SECONDS=20
# 老师长时间不操作，自动进入下一步
TEACHER_TIMEOUT_SECONDS=15
# 单会话最多页数 / 单日模型调用上限（超限降级为轻量模板）
PAGE_LIMIT_PER_SESSION=60
DAILY_CALL_LIMIT=3000

# 童声 ASR 置信度低于该值时走"你是不是说 XX？"确认式追问，不猜
ASR_CONFIRM_THRESHOLD=0.75