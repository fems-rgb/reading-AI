# 环境变量示例：将本文件复制为 .env 并按需修改
# 在代码中通过 os.getenv("HOST") 等方式读取
HOST=127.0.0.1
PORT=8000

# 阿里云百炼 API Key（必填，用于 /ws/voice 实时语音端点）
DASHSCOPE_API_KEY=sk-在这里填你自己的百炼Key


# 可选：百炼实时语音 WebSocket 完整地址（含 model 参数），设置后优先使用。
# 旧型号可用默认域名：wss://dashscope.aliyuncs.com/api-ws/v1/realtime?model=<model>
# 新模型（如 qwen3.8-omni-flash-realtime）须用业务空间专属域名：
#   wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime?model=qwen3.8-omni-flash-realtime
# DASHSCOPE_REALTIME_URL=

# 可选：模型名（未设置 DASHSCOPE_REALTIME_URL 时用于拼接默认域名地址）
# DASHSCOPE_VOICE_MODEL=qwen3.5-omni-plus-realtime

# 可选：多模态视觉模型（/analyze-page 接口使用）
# DASHSCOPE_VISION_MODEL=qwen3.8-omni-flash

# 可选：百炼 OpenAI 兼容模式 HTTP 地址，设置后优先使用；
# 未设置时自动从 DASHSCOPE_REALTIME_URL 提取业务空间域名拼接
# DASHSCOPE_HTTP_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 可选：翻页后留给孩子阅读画面的时间（秒），到点后语音模型才提问，默认 8
# QUESTION_DELAY_SECONDS=5
